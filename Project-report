\section{Algorithm}
\paragraph{Idea.}
Lecture~1 overlaps exactly one block in any solution. Try each block that
overlaps lecture~1 as an \emph{anchor}; place it at coordinate~$0$, unroll the
circle to $[0,L]$ and decide by a left-to-right DP whether the remaining blocks
can be chained so that (C1)--(C3) hold.

For anchor-relative coordinates let, for a position $p$,
\begin{align*}
Q(p)&=\max\{\text{end of a lecture copy starting before }p\},\\
T(p)&=\min\{\text{end of a lecture starting at or after }p\}.
\end{align*}
(Copies shifted by $-L$ account for lectures crossing the anchor's start.)
A block $X$ ending at $x_e$ may be followed by a block $Y$ starting at $y_s$ iff
\[
 x_e\le y_s,\qquad Q(x_e)\le y_s\ \ \text{(no lecture meets both)},\qquad
 y_s<T(x_e)\ \ \text{(no lecture lies strictly in the gap)}.
\]
Closing the cycle is the same test with $y_s=L$; with $k=1$ only the gap test is
needed.

\begin{algorithm}[h]
\caption{\textsc{SelectLectures}$(\text{arcs})$}
\begin{algorithmic}[1]
\State build bit-masks of covered minutes and adjacency bit-sets $\N(\cdot)$
\State $\mathcal B\gets\{\{a,b\}: a\cap b\ne\emptyset,\ \N(a)\cap\N(b)=\emptyset\}$
\If{some block of $\mathcal B$ covers the whole circle} \Return it \EndIf
\For{each $X_0\in\mathcal B$ whose region meets lecture 1}
  \State shift coordinates so $X_0=[0,\ell_0)$; compute $Q,T$ by prefix max / suffix min
  \State $\mathcal C\gets$ blocks lying in $[\ell_0,L]$, sorted by start
  \If{$L<T(\ell_0)$} \Return $X_0$ \EndIf \Comment{$k=1$}
  \For{$Y\in\mathcal C$ in order of start}
     \State $\mathit{reach}[Y]\gets\exists\,X\in\{X_0\}\cup\mathcal C$ reachable before $Y$ with
            $x_e\le y_s,\ Q(x_e)\le y_s<T(x_e)$
     \If{$\mathit{reach}[Y]$ \textbf{and} $Q(y_e)\le L<T(y_e)$} \Return chain to $Y$ \EndIf
  \EndFor
\EndFor
\State \Return \textsc{None}
\end{algorithmic}
\end{algorithm}
