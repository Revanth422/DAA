\section{Structure of every solution}
\begin{definition}[Block]
A pair $\{a,b\}$ of overlapping lectures with $\N(a)\cap\N(b)=\emptyset$.
Its region $R=a\cup b$ is a union of two overlapping arcs.
\end{definition}

\begin{lemma}[Decomposition]\label{lem:decomp}
$S$ is valid iff $S$ is the union of blocks $B_1,\dots,B_k$ ($k\ge1$) with regions
$R_1,\dots,R_k$ such that
\begin{enumerate}
\item[(C1)] the regions are pairwise disjoint;
\item[(C2)] no lecture overlaps two different regions;
\item[(C3)] every lecture overlaps some region.
\end{enumerate}
\end{lemma}
\begin{proof}
($\Rightarrow$) Each $v\in S$ has exactly one neighbour in $S$, so $S$ induces a
perfect matching; its edges are blocks (a common neighbour of $a,b$ would see
two chosen lectures). Lectures from different pairs do not overlap, giving (C1).
A lecture touching two regions would overlap two chosen lectures (it cannot be
chosen, since chosen lectures touch only their partner), giving (C2). Every
lecture needs a chosen neighbour, giving (C3).

($\Leftarrow$) A chosen lecture $a\in B_j$ overlaps its partner and, by (C1),
nothing else chosen. A non-chosen $w$ overlaps some region by (C3), at most one
by (C2), and inside it exactly one of $a,b$ because $\N(a)\cap\N(b)=\emptyset$.
\end{proof}

\begin{lemma}[Few blocks]\label{lem:few}
There are at most $2n$ blocks whose region is not the whole circle.
\end{lemma}
\begin{proof}
If $b\subseteq a$, every lecture touching $b$ touches $a$, so
$\N(b)\setminus\{a\}\subseteq\N(a)\cap\N(b)=\emptyset$: $b$'s only neighbour is
$a$. Hence $b$ determines $a$: at most $n$ nested blocks. If $a,b$ cross (not
nested) the overlap region lies in the tail or head of $a$ and no third lecture
may meet it. Two different partners $b_1,b_2$ at the tail of $a$ would force one
to meet the other's overlap region with $a$, a contradiction. So $a$ has at most
one tail partner and one head partner; counting each crossing block once at the
lecture whose \emph{tail} it uses gives at most $n$ crossing blocks.
\end{proof}

